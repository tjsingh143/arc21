{
  "expo": {
    "name": "Arc 21",
    "slug": "arc21",
    "description": "A simulated blackjack game. Virtual chips only — nothing to buy, nothing to cash out.",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "arc21",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D10",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arc21.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.arc21.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10",
          "resizeMode": "contain",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-audio",
      "expo-notifications",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "disclaimer": "Simulated card game. Virtual chips have no monetary value and cannot be redeemed for money or prizes."
    }
  }
}
