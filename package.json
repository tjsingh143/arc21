{
  "name": "arc21",
  "version": "1.0.0",
  "private": true,
  "description": "Arc 21 — a simulated blackjack game. Virtual chips have no monetary value.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/server/**' && vitest run tests/server --maxWorkers=2",
    "test:watch": "vitest",
    "test:coverage": "COVERAGE=1 vitest run --coverage",
    "lint": "expo lint",
    "doctor": "npx expo-doctor@latest",
    "strategy:generate": "tsx scripts/generate-strategy-tables.ts",
    "audio:generate": "tsx scripts/generate-audio.ts",
    "contrast:check": "tsx scripts/check-contrast.ts",
    "benchmark": "NODE_OPTIONS=--expose-gc tsx scripts/benchmark.ts",
    "art:generate": "tsx scripts/generate-app-art.ts",
    "db:start": "tsx scripts/prepare-local-stack.ts && supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "career:generate": "tsx scripts/generate-career-nodes.ts",
    "check:functions": "bash scripts/check-functions.sh",
    "test:server": "ARC21_REQUIRE_SERVER_STACK=1 vitest run tests/server --maxWorkers=2",
    "test:unit": "vitest run --exclude 'tests/server/**'",
    "bundle:check": "bash scripts/bundle-check.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@hcaptcha/react-native-hcaptcha": "^4.1.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-preset-expo": "^57.0.6",
    "eslint": "^9.37.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
