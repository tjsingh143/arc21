{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The strategy module lives under `supabase/functions/_shared/strategy` and
    // imports its own files with literal `.ts` specifiers, because that is the
    // ONLY form the Supabase Edge runtime resolves — a `.js` specifier fails
    // there even for a file that is certainly present. `exclude` keeps those
    // files out of root discovery but not out of the program, since
    // `shared/strategy/index.ts` re-exports them, so the extension has to be
    // permitted. Safe with `noEmit`: Metro and Deno do the transforms.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Expo's base config does not pull in ambient @types automatically here, and
    // scripts/ is Node tooling (node:fs, node:path) rather than app code.
    // Listing types explicitly disables auto-inclusion, so react must be named too.
    "types": ["node", "react"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // `.expo` is NOT excluded, and that is load-bearing rather than an oversight.
  // `experiments.typedRoutes` writes `.expo/types/router.d.ts`, whose module
  // augmentation is the ONLY thing that makes `router.push("/nowhere")` a type
  // error. `exclude` filters `include`, so listing `.expo` here silently
  // removed that file from the program and typed routes checked nothing: three
  // Quick Play controls shipped pointing at `/game` and `/auth/sign-up`, which
  // are not routes. The generated file is gitignored, so a checkout without it
  // typechecks clean rather than failing — which is why
  // `tests/contracts/every-route-target-exists.test.ts` owns the gate and this
  // is the local convenience.
  "exclude": ["node_modules", "dist", "supabase/functions", ".expo/cache", ".expo/web", ".expo/dev", ".expo/prebuild"]
}
