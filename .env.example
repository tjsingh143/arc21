# Arc 21 — environment configuration
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY: everything prefixed EXPO_PUBLIC_ is compiled into the mobile bundle
# and is PUBLIC. Never put a service-role key, database password or any other
# server secret behind an EXPO_PUBLIC_ prefix. Server secrets belong in Supabase
# Function secret storage, never in this file's public section and never in the
# app bundle.
# ─────────────────────────────────────────────────────────────────────────────


# ── Client (public, safe to ship in the bundle) ──────────────────────────────

# Supabase project URL.
#   Local:  http://127.0.0.1:54321  (printed by `supabase start`)
#   Cloud:  Dashboard → Project Settings → Data API
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key. Safe to expose: it is powerless without a
# valid user session, because Row Level Security governs every table.
#   Local:  printed by `supabase start`
#   Cloud:  Dashboard → Project Settings → API keys
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Build environment: development | preview | production
EXPO_PUBLIC_ENV=development


# ── Server-side only ─────────────────────────────────────────────────────────
# Used by local tooling, migrations and Edge Functions. NOT read by the app.
# In deployed environments these live in Supabase Function secrets, not here.

# Service-role key. Full database access, bypasses RLS. Treat as a root password.
#   Cloud: Dashboard → Project Settings → API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, for migrations and database tests.
SUPABASE_DB_URL=

# HMAC secret used to derive the Daily Challenge shoe. Rotating this changes all
# future daily shoes. Must never reach a client: the seed stays secret while a
# challenge is live and is only revealed afterwards, against a published
# SHA-256 commitment, for auditability.
DAILY_CHALLENGE_SEED_SECRET=


# ── Optional integrations ────────────────────────────────────────────────────
# All are absent by default. The app must run without them: analytics falls back
# to a console adapter and push notifications to a no-op adapter.

# Expo push notifications (requires APNs / FCM credentials configured in EAS).
EXPO_ACCESS_TOKEN=

# Analytics provider key. Leave blank to use the development no-op adapter.
ANALYTICS_WRITE_KEY=
