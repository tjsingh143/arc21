# Arc 21 — environment configuration
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY: everything prefixed EXPO_PUBLIC_ is compiled into the mobile bundle
# and is PUBLIC. Never put a service-role key, database password or any other
# server secret behind an EXPO_PUBLIC_ prefix. Server secrets belong in Supabase
# Function secret storage, never in this file's public section and never in the
# app bundle.
# ─────────────────────────────────────────────────────────────────────────────


# ── Client (public, safe to ship in the bundle) ──────────────────────────────

# Supabase project URL.
#   Local:  http://127.0.0.1:54321  (printed by `supabase start`)
#   Cloud:  Dashboard → Project Settings → Data API
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key. Safe to expose: it is powerless without a
# valid user session, because Row Level Security governs every table.
#   Local:  printed by `supabase start`
#   Cloud:  Dashboard → Project Settings → API keys
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public hCaptcha site key. Enable together with hosted Auth CAPTCHA.
# Never put the private CAPTCHA secret here. Local defaults leave it disabled.
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=
# HTTPS origin registered for that site key; defaults to https://hcaptcha.com.
EXPO_PUBLIC_HCAPTCHA_BASE_URL=

# Build environment: development | preview | production
EXPO_PUBLIC_ENV=development


# ── Server-side only ─────────────────────────────────────────────────────────
# Used by local tooling, migrations and Edge Functions. NOT read by the app.
# In deployed environments these live in Supabase Function secrets, not here.

# Service-role key. Full database access, bypasses RLS. Treat as a root password.
#   Cloud: Dashboard → Project Settings → API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, for migrations and database tests.
SUPABASE_DB_URL=

# Daily seeds are generated per challenge in Postgres and kept in the protected
# daily_challenges.seed_secret column. No shared environment seed is used.


# ── Optional integrations ────────────────────────────────────────────────────
# Absent by default, and the app must run without them.

# Expo push notifications, read by `supabase/functions/send-notifications`. With
# it unset the mock transport runs and every delivery is recorded as `mocked`
# rather than `sent`, so a missing credential cannot read as a delivered push.
EXPO_ACCESS_TOKEN=

# ANALYTICS_WRITE_KEY USED TO BE LISTED HERE AND IS NOT ANY MORE. There is no
# analytics module in this app — no provider, no adapter, no interface — and a
# variable in this file reads as a supported configuration. `docs/PRIVACY.md`
# states that no analytics provider is configured; a key named here contradicted
# it, and the name outlived the code that was going to read it.
